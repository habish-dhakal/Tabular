{
  "name": "tabular",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/server/db/seed.ts",
    "worker": "tsx --env-file=.env src/worker/index.ts",
    "verify:logic": "tsx scripts/qa-audit.mts",
    "verify:backend": "node scripts/verify-backend.mjs",
    "verify:frontend": "node scripts/verify-frontend.mjs",
    "verify": "npm run verify:logic && npm run verify:backend && npm run verify:frontend"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@slack/web-api": "^7.18.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.5",
    "bullmq": "^5.79.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^173.0.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.22.0",
    "nanoid": "^5.1.16",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "ioredis": "$ioredis"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "puppeteer-core": "^25.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
