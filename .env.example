# Copy to .env and fill in real values:  cp .env.example .env

# Postgres connection string.
# The bundled docker-compose exposes Postgres with these dev credentials.
DATABASE_URL="postgresql://tabular:tabular@localhost:5432/tabular"

# Auth.js — generate a strong secret with:  npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Origin the app is served from. Dev defaults to :3100 (see README).
# trustHost is enabled in code, so this is a fallback for the request host.
AUTH_URL="http://localhost:3100"

# Optional GitHub OAuth (leave unset to use the dev email login only).
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# ---- Automations (worker + integrations) ----
# Redis for the BullMQ automation queue (bundled docker-compose exposes this).
REDIS_URL="redis://localhost:6379"

# Set to 1 to stub all outbound integrations (email/Slack/Sheets/HTTP): no
# network calls, payloads are recorded in the run step log. Verify uses this.
# AUTOMATIONS_STUB="1"

# Email (nodemailer SMTP). Either SMTP_URL, or host/port/user/pass.
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM="Tabular <no-reply@tabular.dev>"

# Slack — bot token from an installed Slack app (chat:write; add channels:read,
# groups:read, users:read to browse targets, im:write to DM users).
# SLACK_BOT_TOKEN="xoxb-..."

# Google (Sheets + optional Gmail) — OAuth client + a long-lived refresh token
# obtained once out-of-band with the needed scopes.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REFRESH_TOKEN=""
