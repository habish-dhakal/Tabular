# Copy to .env and fill in real values:  cp .env.example .env

# Postgres connection string.
# The bundled docker-compose exposes Postgres with these dev credentials.
DATABASE_URL="postgresql://tabular:tabular@localhost:5432/tabular"

# Auth.js — generate a strong secret with:  npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Origin the app is served from. Dev defaults to :3100 (see README).
# trustHost is enabled in code, so this is a fallback for the request host.
AUTH_URL="http://localhost:3100"

# GitHub OAuth — the real sign-in method for production. Set both to enable the
# "Continue with GitHub" button. Leave unset for dev-only email login.
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# The dev email login (no password, auto-provisions users) is enabled outside
# production only. Set to 1 to force-enable it in production too (e.g. staging).
# WARNING: it lets anyone sign in as any email — never enable on a real deployment.
# ALLOW_DEV_LOGIN="1"

# ---- Rate limiting (per-client API throttle) ----
# On in production; off elsewhere. Set to 1 to force-enable (e.g. to test it in
# dev — the verify suites hammer one IP, so leave it off during those).
# RATE_LIMIT_FORCE="1"
# Requests allowed per window per client IP (default 240). 0 disables.
# RATE_LIMIT_MAX="240"
# Window length in seconds (default 60).
# RATE_LIMIT_WINDOW_SEC="60"

# ---- Automations (worker + integrations) ----
# Redis for the BullMQ automation queue (bundled docker-compose exposes this).
REDIS_URL="redis://localhost:6379"

# Set to 1 to stub all outbound integrations (email/Slack/Sheets/HTTP): no
# network calls, payloads are recorded in the run step log. Verify uses this.
# AUTOMATIONS_STUB="1"

# Email (nodemailer SMTP). Either SMTP_URL, or host/port/user/pass.
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM="Tabular <no-reply@tabular.dev>"

# Slack — bot token from an installed Slack app (chat:write; add channels:read,
# groups:read, users:read to browse targets, im:write to DM users).
# SLACK_BOT_TOKEN="xoxb-..."

# Google (Sheets + optional Gmail) — OAuth client + a long-lived refresh token
# obtained once out-of-band with the needed scopes.


